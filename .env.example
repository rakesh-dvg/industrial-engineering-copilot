# =============================================================================
# Industrial Engineering Copilot — environment template
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# Application
APP_NAME=Industrial Engineering Copilot
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# LOCAL development
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://iec:iec@localhost:5432/iec
DATABASE_URL_SYNC=postgresql+psycopg://iec:iec@localhost:5432/iec
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=iec-documents
MINIO_SECURE=false
VITE_API_BASE_URL=http://localhost:8020

# Groq LLM (backend only — never expose to frontend)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Auth (Phase 1 foundation — replace in production)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional live Groq integration tests (default: false)
RUN_GROQ_INTEGRATION_TESTS=false

# Embedding provider (deterministic MVP default)
EMBEDDING_PROVIDER=deterministic
EMBEDDING_DIMENSIONS=384

# -----------------------------------------------------------------------------
# AWS MVP deployment (documented values — set in ECS/RDS/Secrets Manager)
# Do NOT commit real AWS credentials or API keys.
# -----------------------------------------------------------------------------
# AWS_REGION=us-east-1
# DATABASE_URL=postgresql+asyncpg://iec_admin:<password>@<rds-endpoint>:5432/iec
# DATABASE_URL_SYNC=postgresql+psycopg://iec_admin:<password>@<rds-endpoint>:5432/iec
# CORS_ORIGINS=["http://<alb-dns-name>"]
# MINIO_ENDPOINT=s3.us-east-1.amazonaws.com
# MINIO_ACCESS_KEY=<iam-access-key-or-task-role-via-secrets>
# MINIO_SECRET_KEY=<iam-secret-key>
# S3_BUCKET=<your-private-bucket-name>
# MINIO_BUCKET=<same-as-s3-bucket>
# MINIO_SECURE=true
# GROQ_API_KEY=<stored-in-secrets-manager>
# VITE_API_BASE_URL=
#   Leave empty for AWS frontend builds. Browser calls same-origin /api/* via ALB.
