# Application
APP_NAME=Industrial Engineering Copilot
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://iec:iec@localhost:5432/iec
DATABASE_URL_SYNC=postgresql+psycopg://iec:iec@localhost:5432/iec

# Auth (Phase 1 foundation — replace in production)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (job queue foundation)
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=iec-documents
MINIO_SECURE=false

# Groq LLM (backend only — never expose to frontend)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional live Groq integration tests (default: false)
RUN_GROQ_INTEGRATION_TESTS=false

# Frontend (Vite dev server)
VITE_API_BASE_URL=http://localhost:8000
