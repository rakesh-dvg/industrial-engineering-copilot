# Backend API base URL (no trailing slash).
# Docker Compose maps backend to host port 8020.
VITE_API_BASE_URL=http://localhost:8020

# If running uvicorn directly on port 8000 instead:
# VITE_API_BASE_URL=http://localhost:8000

# Local Vite UI against a remote backend (ECS/public IP or ALB) — avoid browser CORS:
# VITE_API_BASE_URL=http://<backend-host>:8000
# VITE_DEV_API_PROXY=true
# Restart `npm run dev` after changing env vars.

# Production nginx container (docker run / ECS): leave VITE_API_BASE_URL empty at build.
# Set runtime BACKEND_API_URL=http://<backend-host>:8000 on the frontend container.
# ECS public IPs are ephemeral — update BACKEND_API_URL and restart when the IP changes,
# or bake VITE_API_BASE_URL at build time for direct browser calls (needs CORS on backend).
